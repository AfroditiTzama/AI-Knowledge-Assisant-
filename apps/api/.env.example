APP_ENV=development
APP_DEBUG=false
FRONTEND_BASE_URL=http://127.0.0.1:5173
DATABASE_URL=sqlite+aiosqlite:///./knowledge_assistant.db
DOCUMENTS_STORAGE_DIRECTORY=storage/documents
DOCUMENT_MAX_UPLOAD_BYTES=26214400
DOCUMENT_UPLOAD_CHUNK_BYTES=1048576
DOCUMENT_MAX_PDF_PAGES=500
DOCUMENT_MAX_EXTRACTED_TEXT_CHARACTERS=5000000
DOCUMENT_MAX_DOCX_UNCOMPRESSED_BYTES=104857600
DOCUMENT_MAX_DOCX_ARCHIVE_ENTRIES=2048
DOCUMENT_MAX_DOCX_COMPRESSION_RATIO=100
CHROMA_STORAGE_DIRECTORY=storage/chroma
MAIL_OUTBOX_DIRECTORY=storage/mail_outbox
CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173

# Required. Replace this rejected example with a unique random value of at least 32 characters.
JWT_SECRET_KEY=replace-with-at-least-32-random-characters
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
ACCOUNT_ACTION_TOKEN_EXPIRE_MINUTES=30

# auto => Lax locally, None+Secure in production.
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAMESITE=auto
# AUTH_COOKIE_DOMAIN=

LOGIN_MAX_FAILED_ATTEMPTS=5
LOGIN_LOCK_MINUTES=15
AUTH_RATE_LIMIT_REQUESTS=20
AUTH_RATE_LIMIT_WINDOW_SECONDS=60
AUTH_RATE_LIMIT_MAX_KEYS=10000
# Comma-separated proxy IPs or CIDRs. Leave empty when clients connect directly.
TRUSTED_PROXY_CIDRS=

# outbox writes .eml files to storage/mail_outbox.
# smtp uses the SMTP settings below.
MAIL_DELIVERY_MODE=outbox
MAIL_FROM_ADDRESS=no-reply@knowledge-ai.local
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USERNAME=
# SMTP_PASSWORD=
# SMTP_USE_TLS=true
